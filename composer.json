{
    "name": "hotel/reservation",
    "description": "Event Sourced Hotel Reservation System",
    "type": "project",
    "autoload": {
        "psr-4": {
            "Reservation\\": "src/Reservation/",
            "Common\\": "src/Common/",
            "Finance\\": "src/Finance/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "require": {
        "php": "^8.1",
        "eventsauce/eventsauce": "^3.0",
        "ramsey/uuid": "^4.2",
        "league/tactician": "^1.1",
        "eventsauce/message-repository-for-doctrine": "^1.2",
        "php-di/php-di": "^7.0",
        "doctrine/orm": "^3.3",
        "doctrine/dbal": "^4.2",
        "doctrine/migrations": "^3.9"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0",
        "eventsauce/test-utilities": "^3.0"
    },
    "scripts": {
        "test": "phpunit",
        "test:integration": "php bin/run_integration_tests.php"
    },
    "minimum-stability": "stable"
}
